# MongoDB Atlas (replace USER, PASSWORD, and database name — do not commit real secrets)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/careerai?retryWrites=true&w=majority

JWT_SECRET=change_this_to_a_long_random_string

# 64 hex chars: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=

# Optional: fallback LinkedIn automation when user has not saved encrypted creds in profile
LINKEDIN_USERNAME=
LINKEDIN_PASSWORD=

PORT=3000
NODE_ENV=development
