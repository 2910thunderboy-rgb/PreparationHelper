# MongoDB Atlas (replace USER, PASSWORD, and database name — do not commit real secrets)
MONGO_URI=mongodb+srv://shaunak2910:shaunakraiker@cluster0.z9afkdr.mongodb.net/?appName=Cluster0

# Required for auth + (if FIELD_ENCRYPTION_KEY omitted) derived field encryption for LinkedIn secrets
JWT_SECRET=change_this_to_a_long_random_string

# Optional: explicit AES key — openssl rand -hex 32
# If omitted, a 32-byte key is derived from JWT_SECRET (set FIELD_ENCRYPTION_KEY in production if you rotate JWT_SECRET)
FIELD_ENCRYPTION_KEY=

# Optional: fallback LinkedIn automation when user has not saved encrypted creds in profile
LINKEDIN_USERNAME=
LINKEDIN_PASSWORD=

PORT=3000
NODE_ENV=development
